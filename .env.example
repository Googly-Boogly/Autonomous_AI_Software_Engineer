# Copy to .env and `set -a; source .env; set +a` (the engineer never reads .env itself).

# --- Who writes the code ------------------------------------------------------
ENGINEER_PROVIDER=claude-code        # claude-code | anthropic | scripted
# ENGINEER_MODEL=                    # default: Claude Code's configured model
# ENGINEER_CLAUDE_CLI=/path/to/claude
# Optional with claude-code (a `claude` login works); required for --provider anthropic.
# Never placed in prompts/logs, never forwarded to commands that execute repo code.
ANTHROPIC_API_KEY=
ENGINEER_EFFORT=high                 # anthropic provider only: low | medium | high | xhigh | max

# --- Limits -------------------------------------------------------------------
MAX_AGENT_ITERATIONS=5               # implement -> validate -> debug cycles
MAX_TOOL_CALLS_PER_ITERATION=40
ENGINEER_COMMAND_TIMEOUT=300         # seconds per validation command

# --- Behaviour ----------------------------------------------------------------
REQUIRE_PLAN_APPROVAL=false          # true => runs pause for approval (use --approve-plan)
ENGINEER_DATA_DIR=data               # runs/, worktrees and engineer.db live here
# ENGINEER_PYTHON=/path/to/python    # interpreter used to run pytest/ruff/mypy
# ENGINEER_EXTRA_SENSITIVE_PATTERNS=*.sqlite,config/prod/

# --- Docker (docker compose only) ------------------------------------------------
# HOST_UID=1000                      # build the image as your user: `id -u` / `id -g`
# HOST_GID=1000
# ENGINEER_REPOS_DIR=/path/to/repos  # mounted at /repos (default: ./examples)
